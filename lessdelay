                    ty = cs.Y + vy / L * ringPx
                else
                    tx, ty = sp.X, sp.Y
                end
            end
        end
        if not tx then
            walk.aimAng = (walk.aimAng or 0) + 0.03
            local ang = walk.aimAng
            tx = cs.X + math.cos(ang) * ringPx
            ty = cs.Y + math.sin(ang) * ringPx
        end
        pcall(mousemoveabs, tx, ty)
    end)

