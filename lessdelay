_G.__shE = 0.12
_G.__shT = 0
_G.__shSig = nil
_G.__shieldDraw = function(c, R, ballPos, flashing)
    local now = tick()
    local dt = now - (_G.__shT or now)
    if dt <= 0 or dt > 0.2 then dt = 0.016 end
    _G.__shT = now
    local curA = _G.__shA or 0
    local curE = _G.__shE or 0.12
    local tgtA, tgtE = nil, 0.12
    if ballPos then
        local dx, dy, dz = ballPos.X - c.X, ballPos.Y - c.Y, ballPos.Z - c.Z
        local horiz = math.sqrt(dx * dx + dz * dz)
        if horiz > 0.5 then
            tgtA = math.atan2(dz, dx)
            tgtE = math.clamp(math.atan2(dy, horiz), 0.02, 0.95)
        end
    end
    if tgtA then
        local da = (tgtA - curA + math.pi) % TAU - math.pi
        local k = math.clamp(dt * 6, 0, 1)
        curA = curA + da * k
        curE = curE + (tgtE - curE) * k
    else
        local spd = math.rad(tonumber(lala.spinSpeed) or 45) * 0.6
        curA = curA + spd * dt
        curE = curE + (tgtE - curE) * math.clamp(dt * 3, 0, 1)
    end
    _G.__shA, _G.__shE = curA, curE
    local acr, acg, acb = lala.apColor.r or 0, lala.apColor.g or 255, lala.apColor.b or 120
    local atrans = lala.apTrans or 5
    local athick = lala.apThick or 2
    local bfill = flashing and 0.05 or atrans / 100
    local col = flashing and Color3.fromRGB(255, 40, 40) or Color3.fromRGB(acr, acg, acb)
    local sig = col.R .. "," .. col.G .. "," .. col.B .. "," .. tostring(atrans) .. "," .. tostring(flashing) .. "," .. tostring(athick)
    if _G.__shSig ~= sig then
        _G.__shSig = sig
        local ft = math.clamp(bfill * 0.26 + 0.72, 0, 0.98)
        local lt = math.clamp(bfill + 0.3, 0, 1)
        for i = 1, 96 do
            _G.__shieldTris[i].Color = col
            _G.__shieldTris[i].Transparency = ft
        end
        for i = 1, 36 do
            _G.__shieldLn[i].Color = col
            _G.__shieldLn[i].Transparency = lt
            _G.__shieldLn[i].Thickness = athick
        end
    end
    local ROWS, COLS = 8, 6
    local stride = COLS + 1
    local baseR = 6.5
    local tgtR = baseR
    if ballPos then tgtR = math.clamp(R, baseR + 1, tonumber(lala.maxDist) or 60) end
    _G.__shR = _G.__shR or tgtR
    local rr = _G.__shR + (tgtR - _G.__shR) * math.clamp(dt * 3.2, 0, 1)
    _G.__shR = rr
    local sc = math.sqrt(rr / baseR)
    local halfW = (2.0 * sc) / rr
    local vSpan = (4.6 * sc) / rr
    local eTop = curE + vSpan * 0.35
    local eBot = curE - vSpan * 0.65
    if eBot < -0.12 then
        local d = -0.12 - eBot
        eTop = eTop + d
        eBot = eBot + d
    end
    _G.__shP = _G.__shP or {}
    _G.__shV = _G.__shV or {}
    local P, V = _G.__shP, _G.__shV
    local idx = 0
    for i = 0, ROWS do
        local v = i / ROWS
        local w
        if v <= 0.42 then
            local t = (0.42 - v) / 0.42
            w = 1 - 0.20 * t * t * t
        else
            local t = (v - 0.42) / 0.58
            w = (1 - t) ^ 0.8
        end
        local e = eTop - v * (eTop - eBot)
        local ce, se = math.cos(e), math.sin(e)
        for j = 0, COLS do
            local u = j / COLS - 0.5
            local a = curA + u * 2 * halfW * w
            local wp = c + Vector3.new(ce * math.cos(a) * rr, 1.1 + se * rr, ce * math.sin(a) * rr)
            local sp, ok = WorldToScreen(wp)
            idx = idx + 1
            P[idx] = sp
            V[idx] = ok
        end
    end
    local tris, lns = _G.__shieldTris, _G.__shieldLn
    local ti = 0
    for i = 0, ROWS - 1 do
        local r0 = i * stride
        local r1 = r0 + stride
        for j = 0, COLS - 1 do
            local p0, p1 = r0 + j + 1, r0 + j + 2
            local q0, q1 = r1 + j + 1, r1 + j + 2
            ti = ti + 1
            local t1 = tris[ti]
            if V[p0] and V[p1] and V[q0] then
                t1.PointA = P[p0]; t1.PointB = P[p1]; t1.PointC = P[q0]; t1.Visible = true
            elseif t1.Visible then t1.Visible = false end
            ti = ti + 1
            local t2 = tris[ti]
            if V[p1] and V[q1] and V[q0] then
                t2.PointA = P[p1]; t2.PointB = P[q1]; t2.PointC = P[q0]; t2.Visible = true
            elseif t2.Visible then t2.Visible = false end
        end
    end
    local li = 0
    for j = 0, COLS - 1 do
        li = li + 1
        local ln = lns[li]
        local a, b = j + 1, j + 2
        if V[a] and V[b] then ln.From = P[a]; ln.To = P[b]; ln.Visible = true elseif ln.Visible then ln.Visible = false end
    end
    for i = 0, ROWS - 1 do
        li = li + 1
        local ln = lns[li]
        local a = i * stride + 1
        local b = a + stride
        if V[a] and V[b] then ln.From = P[a]; ln.To = P[b]; ln.Visible = true elseif ln.Visible then ln.Visible = false end
    end
    for i = 0, ROWS - 1 do
        li = li + 1
        local ln = lns[li]
        local a = i * stride + COLS + 1
        local b = a + stride
        if V[a] and V[b] then ln.From = P[a]; ln.To = P[b]; ln.Visible = true elseif ln.Visible then ln.Visible = false end
    end
    for i = 0, ROWS - 1 do
        li = li + 1
        local ln = lns[li]
        local a = i * stride + 4
        local b = a + stride
        if V[a] and V[b] then ln.From = P[a]; ln.To = P[b]; ln.Visible = true elseif ln.Visible then ln.Visible = false end
    end
    local cbRow = 2 * stride
    for j = 0, COLS - 1 do
        li = li + 1
        local ln = lns[li]
        local a, b = cbRow + j + 1, cbRow + j + 2
        if V[a] and V[b] then ln.From = P[a]; ln.To = P[b]; ln.Visible = true elseif ln.Visible then ln.Visible = false end
    end
end
