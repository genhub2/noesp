            if not kb then return end
            for _, b in ipairs(kb:GetChildren()) do
                if b.ClassName == "ImageButton" and string.sub(b.Name, 1, 7) == "Keybind" then
                    local txt = string.upper(readText(b:FindFirstChild("TextBox")))
