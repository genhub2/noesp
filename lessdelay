_G.__drawExtraView = function(mode, ptsIn, vflIn, c, R, ballPos, flashing)
    _G.__hideExtraViews()
    local acr, acg, acb = lala.apColor.r or 0, lala.apColor.g or 255, lala.apColor.b or 120
    local atrans = lala.apTrans or 5
    local athick = lala.apThick or 2
    local bfill = flashing and 0.05 or atrans / 100
    local lalpha = math.clamp(bfill + 0.3, 0, 1)
    local col = flashing and Color3.fromRGB(255, 40, 40) or Color3.fromRGB(acr, acg, acb)
    local sig = acr .. "," .. acg .. "," .. acb .. "," .. tostring(atrans) .. "," .. tostring(flashing) .. "," .. tostring(athick)
    if sig ~= _G.__vSig then
        _G.__vSig = sig
        for i = 1, DN do
            ring2Lines[i].Color = col; ring2Lines[i].Transparency = lalpha; ring2Lines[i].Thickness = athick
            strutLines[i].Color = col; strutLines[i].Transparency = lalpha; strutLines[i].Thickness = athick
            discTris[i].Color = col; discTris[i].Transparency = math.clamp(bfill * 0.26 + 0.72, 0, 0.98)
        end
        for i = 1, 12 * DN do latLines[i].Color = col; latLines[i].Transparency = lalpha; latLines[i].Thickness = athick end
        for i = 1, 2 do laneLines[i].Color = col; laneLines[i].Transparency = lalpha; laneLines[i].Thickness = athick end
    end
    if mode == "Cylinder" then
        local topR = R
        local topH = R * 0.8
        local sp = _G.__spinA or 0
        for i = 1, DN do
            local az = ((i - 1) / DN) * TAU + sp
            local az2 = (i / DN) * TAU + sp
            local bp, bv = WorldToScreen(c + Vector3.new(math.cos(az) * R, 0, math.sin(az) * R))
            local tp, tv = WorldToScreen(c + Vector3.new(math.cos(az) * topR, topH, math.sin(az) * topR))
            local t2p, t2v = WorldToScreen(c + Vector3.new(math.cos(az2) * topR, topH, math.sin(az2) * topR))
            if bv and tv then strutLines[i].From = bp; strutLines[i].To = tp; strutLines[i].Visible = true end
            if tv and t2v then ring2Lines[i].From = tp; ring2Lines[i].To = t2p; ring2Lines[i].Visible = true end
        end
    elseif mode == "Grid Dome" then
        local nLat = 0
        for li = 1, 5 do
            local row = li * 2
            for j = 1, DN do
                local a = vidx(row, j - 1)
                local b = vidx(row, j)
                nLat = nLat + 1
                local ln = latLines[nLat]
                if vflIn[a] and vflIn[b] then ln.From = ptsIn[a]; ln.To = ptsIn[b]; ln.Visible = true end
            end
        end
        for lv = 1, 6 do
            local r1 = (lv - 1) * 2
            local r2 = lv * 2
            for j = 1, DN do
                local a = vidx(r1, j - 1)
                local b = vidx(r2, j - 1)
                nLat = nLat + 1
                local ln = latLines[nLat]
                if vflIn[a] and vflIn[b] then ln.From = ptsIn[a]; ln.To = ptsIn[b]; ln.Visible = true end
            end
        end
    elseif mode == "Disc" then
        local mp, mv = WorldToScreen(c)
        if mv then
            for j = 1, DN do
                local a = vidx(0, j - 1)
                local b = vidx(0, j)
                if vflIn[a] and vflIn[b] then
                    discTris[j].PointA = mp
                    discTris[j].PointB = ptsIn[a]
                    discTris[j].PointC = ptsIn[b]
                    discTris[j].Visible = true
                end
            end
        end
    elseif mode == "Double Ring" then
        local R2 = R * 1.35
        for j = 1, DN do
            local az = ((j - 1) / DN) * TAU
            local az2 = (j / DN) * TAU
            local p1, v1 = WorldToScreen(c + Vector3.new(math.cos(az) * R2, 0, math.sin(az) * R2))
            local p2, v2 = WorldToScreen(c + Vector3.new(math.cos(az2) * R2, 0, math.sin(az2) * R2))
            if v1 and v2 then ring2Lines[j].From = p1; ring2Lines[j].To = p2; ring2Lines[j].Visible = true end
        end
    elseif mode == "Lane" then
        local bp = ballPos or (c + Vector3.new(0, 0, -R))
        local dx, dz = bp.X - c.X, bp.Z - c.Z
        local d = math.sqrt(dx * dx + dz * dz)
        if d > 1 then
            local ux, uz = dx / d, dz / d
            local px, pz = -uz, ux
            local w = R * 0.25
            local len = math.min(d, R * 3)
            local s1, sv1 = WorldToScreen(c + Vector3.new(px * w, 0, pz * w))
            local s2, sv2 = WorldToScreen(c + Vector3.new(-px * w, 0, -pz * w))
            local e1, ev1 = WorldToScreen(c + Vector3.new(ux * len + px * w, 0, uz * len + pz * w))
            local e2, ev2 = WorldToScreen(c + Vector3.new(ux * len - px * w, 0, uz * len - pz * w))
            if sv1 and ev1 then laneLines[1].From = s1; laneLines[1].To = e1; laneLines[1].Visible = true end
            if sv2 and ev2 then laneLines[2].From = s2; laneLines[2].To = e2; laneLines[2].Visible = true end
        end
    elseif mode == "Shield" then
        _G.__shieldDraw(c, R, ymer.threatPos, flashing)
    elseif mode == "Tether" then
        _G.__tetherDraw(c, R, ballPos, flashing)
    elseif mode == "Particle Wall" then
        _G.__pwDraw(c, R, ymer.threatPos, flashing)
    elseif mode == "Energy Ribbon" then
        _G.__ribDraw(c, R, ymer.threatPos, flashing)
    elseif mode == "Wings" then
        _G.__wingsDraw(c, R, ymer.threatPos, flashing)
    elseif mode == "Duo Strike" then
        _G.__duoDraw(c, R, ymer.threatPos, flashing)
    elseif mode == "Trajectory Tunnel" then
        if ballPos and c and (R or 0) > 0 then
            local vec = c - ballPos
            local d = vec.Magnitude
            if d > 1 then
                local u = vec / d
                local up = Vector3.new(0, 1, 0)
                local right = u:Cross(up)
                if right.Magnitude < 0.01 then right = u:Cross(Vector3.new(1, 0, 0)) end
                if right.Magnitude < 0.01 then right = u:Cross(Vector3.new(0, 0, 1)) end
                right = right.Unit
                local up2 = right:Cross(u).Unit
                local span = math.min(d, math.clamp(R * 3.0, 12, 85))
                local baseRad = math.clamp(R * 0.45, 2.8, 5.5)
                local rings = 10
                local twist = TAU / DN
                local sphase = _G.__spinOn() and (_G.__spinA or 0) or 0
                local RP = _G.__tunP or {}
                local RV = _G.__tunV or {}
                _G.__tunP = RP
                _G.__tunV = RV
                local idx = 0
                for ri = 1, rings do
                    local frac = (rings - ri) / (rings - 1)
                    local pos = c - u * (span * frac)
                    local rad = baseRad * (1 + 0.35 * frac)
                    local ph = sphase + (ri - 1) * twist
                    for j = 0, DN - 1 do
                        local a = (j / DN) * TAU + ph
                        local sp, sv = WorldToScreen(pos + right * (math.cos(a) * rad) + up2 * (math.sin(a) * rad))
                        idx = idx + 1
                        RP[idx] = sp
                        RV[idx] = sv
                    end
                end
                local li = 0
                for ri = 0, rings - 1 do
                    for j = 0, DN - 1 do
                        local a = ri * DN + j + 1
                        local b = ri * DN + ((j + 1) % DN) + 1
                        li = li + 1
                        local ln = latLines[li]
                        if RV[a] and RV[b] then ln.From = RP[a]; ln.To = RP[b]; ln.Visible = true end
                    end
                end
                for s = 0, 2 do
                    local j0 = math.floor(s * DN / 3)
                    for ri = 0, rings - 2 do
                        local ja = (j0 - ri) % DN
                        local jb = (j0 - ri - 1) % DN
                        local a = ri * DN + ja + 1
                        local b = (ri + 1) * DN + jb + 1
                        li = li + 1
                        local ln = latLines[li]
                        if RV[a] and RV[b] then ln.From = RP[a]; ln.To = RP[b]; ln.Visible = true end
                    end
                end
            end
        end
    end
end

